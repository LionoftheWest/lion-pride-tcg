# --- Secrets: never commit real env files (keep the .example templates) ---
.env
**/.env
!.env.example
!**/.env.example
*.key
*.pem

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Generated build output ---
**/out/
**/dist/
tcg-activity/public/main.*.js
tcg-activity/public/chunk.*.js
card-studio/public-gallery/
card-studio/gallery-deploy/dist/

# --- Separate project, not part of lion-pride-tcg ---
smash-ranker/

# --- Local-only data / overrides ---
*.local.json

# --- Large binaries / tools ---
cloudflared.exe
*.exe

# --- Logs & OS cruft ---
*.log
.DS_Store
Thumbs.db

# --- Python cruft ---
__pycache__/
*.pyc

# --- card-studio/ml: venvs, cloned model repos, weights, generated meshes (GBs) ---
# Keep only our own driver scripts.
card-studio/ml/*
!card-studio/ml/*.py

# --- Local scratch (2026-10-02): backed up to the PRIVATE repo lion-pride-tcg-tools, never here ---
# (they hold member ids, local paths and Management API calls)
.live-review/
card-studio/q-*.mjs
card-studio/_sim-*.mjs
tcg-activity/preview/

