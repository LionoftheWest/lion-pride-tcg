# Lion Pride TCG — Discord Activity
# Copy to .env and fill in. NEVER commit the real .env.

# Your Discord application's id (same as the bot's DISCORD_CLIENT_ID).
DISCORD_CLIENT_ID=

# OAuth2 client secret — Dev Portal > your app > OAuth2 > Client Secret > Reset/Copy.
# This is NOT the bot token. The backend needs it to swap codes for tokens.
DISCORD_CLIENT_SECRET=

# Same Supabase project the bot + studio use (kgvdqqehefezbypozvrh).
SUPABASE_URL=https://kgvdqqehefezbypozvrh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Local port for the backend.
PORT=4441

# --- Live pack-opening (Phase 3) ---
# The shared secret that lets this backend open packs through the bot's internal
# endpoint. Must MATCH the bot's INTERNAL_TOKEN. Leave empty to disable opening.
INTERNAL_TOKEN=
# Where the bot's internal endpoint lives (default: same VM, localhost).
BOT_INTERNAL_URL=http://127.0.0.1:4451
