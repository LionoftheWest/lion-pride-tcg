# Copy this file to .env and fill in the values from the Discord Developer Portal.
# https://discord.com/developers/applications

# Bot token (Application -> Bot -> Reset Token).
DISCORD_TOKEN=

# Application ID (Application -> General Information -> Application ID).
DISCORD_CLIENT_ID=

# Your server ID (right-click the server icon -> Copy Server ID; needs Developer Mode on).
# Set this so slash commands appear in your server instantly.
# Leave it empty to register commands globally (can take up to one hour to appear).
DISCORD_GUILD_ID=

# --- Supabase (your PERSONAL project, never an R3VCORE project) ---
# Project URL: Supabase dashboard -> Project Settings -> Data API -> Project URL.
SUPABASE_URL=

# The server-side key that bypasses row level security. The bot needs it,
# because it writes for every member. Keep it secret and server-side only.
# New Supabase projects: use the SECRET key (it starts with "sb_secret_").
# Older projects: use the "service_role" key. They are the same role.
# It is never shared with the web UI, which uses the publishable (anon) key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Internal open endpoint (for the Discord Activity) ---
# A shared secret. The Activity backend sends it to open a player's earned packs
# through the bot, so the bot stays the one source of truth for the economy. Set
# the SAME value in the Activity's .env. Leave empty to disable the endpoint.
INTERNAL_TOKEN=
# The localhost port the internal endpoint listens on (default 4451).
INTERNAL_PORT=4451

# --- Notifications channel ---
# The Discord channel id where hunt events post (spawn, reminder, defeat, and so on).
# Leave empty to disable channel posts (the game still works). Example: tcg-notifications.
NOTIF_CHANNEL_ID=
