# Logs: delete the session token from logged URLs (the pulls stream and the WebSocket send
# ?token=; every aborted stream wrote it to the log). Audit, 2026-10-03.
{
    log default {
        format filter {
            request>uri query {
                delete token
            }
        }
    }
}

lionpridetcg.duckdns.org {
    encode zstd gzip
    route {
        redir /app /app/
        handle /cimg/* {
            reverse_proxy localhost:4441 {
                # A deploy restarts the Activity: retry the refused connection, do not answer 502.
                lb_try_duration 20s
                lb_try_interval 250ms
            }
        }
        handle_path /app/* {
            reverse_proxy localhost:4441 {
                # A deploy restarts the Activity: retry the refused connection, do not answer 502.
                lb_try_duration 20s
                lb_try_interval 250ms
            }
        }
        reverse_proxy localhost:4331
    }
}

studio.lionpridetcg.duckdns.org {
    encode zstd gzip
    reverse_proxy localhost:4399
}
