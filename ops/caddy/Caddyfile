    encode zstd gzip
    route {
        redir /app /app/
        handle /cimg/* {
            reverse_proxy localhost:4441
        }
        handle_path /app/* {
            reverse_proxy localhost:4441
        }
        reverse_proxy localhost:4331
    }
}

